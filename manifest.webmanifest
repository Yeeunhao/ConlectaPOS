{
  "name": "Conlecta POS",
  "short_name": "Conlecta",
  "description": "Conlecta point of sale. Install once; QR Display opens in a separate window on desktop or Mac.",
  "start_url": "/cashier?source=pwa",
  "scope": "/",
  "id": "conlecta-pos",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#120a1f",
  "theme_color": "#6b21a8",
  "orientation": "any",
  "categories": ["business", "finance"],
  "icons": [
    {
      "src": "/assets/ConlectaTabLogo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/ConlectaTabLogo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Cashier",
      "short_name": "Cashier",
      "url": "/cashier?source=shortcut"
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "/settings?source=shortcut"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "prefer_related_applications": false
}
